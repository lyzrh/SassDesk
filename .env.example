# SassDesk 环境变量示例（复制为 .env 或 config.local.json 使用，切勿提交真实 Key）
# 通用优先：SassDesk 先读 SASSDESK_API_KEY
SASSDESK_API_KEY=

# 按 provider 命名的标准变量（pi-ai 原生识别；SassDesk 也读它们作为回退）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=

# 语音识别（whisper provider 使用，兼容 OpenAI /v1/audio/transcriptions 的任意端点）
SASSDESK_STT_API_KEY=
SASSDESK_STT_BASE_URL=
