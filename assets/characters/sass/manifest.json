{
  "$schema": "./manifest.schema.json",
  "id": "sass",
  "name": "Sass（萨斯）",
  "version": "0.1.0",
  "species": "灰蓝色小狐狸",
  "description": "好奇、喜欢钻研、偶尔有点小傲娇的桌面 AI 员工。灰蓝色毛发，白色脸颊/胸口/尾巴尖，深色连帽衫，科技蓝灯光耳机。",
  "visualSpec": {
    "fur": "灰蓝色（主）+ 白色（脸颊、胸口、尾巴尖）",
    "outfit": "深色连帽衫 + 科技蓝灯光耳机",
    "style": "Q 版 / 轻微二次元 / 治愈，非写实动物风",
    "palette": ["#8DA3B8", "#5B7A99", "#FFFFFF", "#2B3440", "#59C2FF"]
  },
  "window": {
    "width": 240,
    "height": 280,
    "scale": 1.0,
    "alwaysOnTop": false
  },
  "bubble": {
    "style": "dark",
    "maxChars": 90,
    "durationMs": 6000,
    "colors": { "bg": "#222B36CC", "text": "#E8EEF5", "accent": "#59C2FF" }
  },
  "fallback": "placeholder.svg",
  "states": {
    "idle": {
      "label": "待机",
      "src": "animated/idle.svg",
      "poster": "idle/idle.png",
      "frames": 1,
      "frameSize": { "width": 240, "height": 240 },
      "fps": 0,
      "animation": "rigged",
      "hints": "自然待机、眨眼、尾巴三节波浪摆、耳朵偶发抖动"
    },
    "listening": {
      "label": "聆听",
      "src": "animated/listening.svg",
      "poster": "listening/listening.png",
      "frames": 1,
      "frameSize": { "width": 240, "height": 240 },
      "fps": 0,
      "animation": "rigged",
      "hints": "双耳竖起快速转向、身体前倾、尾巴快摆"
    },
    "thinking": {
      "label": "思考",
      "src": "animated/thinking.svg",
      "poster": "thinking/thinking.png",
      "frames": 1,
      "frameSize": { "width": 240, "height": 240 },
      "fps": 0,
      "animation": "rigged",
      "hints": "歪头、托腮轻点、尾巴慢卷"
    },
    "working": {
      "label": "工作",
      "src": "animated/working.svg",
      "poster": "working/working.png",
      "frames": 1,
      "frameSize": { "width": 240, "height": 240 },
      "fps": 0,
      "animation": "rigged",
      "hints": "坐在笔记本前双爪交替打字、屏幕闪烁、专注俯身"
    },
    "success": {
      "label": "成功",
      "src": "animated/success.svg",
      "poster": "success/success.png",
      "frames": 1,
      "frameSize": { "width": 240, "height": 240 },
      "fps": 0,
      "animation": "rigged",
      "hints": "弹跳庆祝、双臂上举挥动、尾巴高频摇摆、星光闪烁"
    },
    "error": {
      "label": "出错",
      "src": "animated/error.svg",
      "poster": "error/error.png",
      "frames": 1,
      "frameSize": { "width": 240, "height": 240 },
      "fps": 0,
      "animation": "rigged",
      "hints": "耳朵耷拉颤动、身体萎缩、摇头"
    },
    "sleeping": {
      "label": "休息",
      "src": "animated/sleeping.svg",
      "poster": "sleeping/sleeping.png",
      "frames": 1,
      "frameSize": { "width": 240, "height": 240 },
      "fps": 0,
      "animation": "rigged",
      "hints": "趴姿、缓慢呼吸起伏、尾巴慢摆"
    }
  }
}
